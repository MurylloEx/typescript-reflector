{
  "name": "typescript-reflector",
  "version": "1.0.0",
  "description": "Fluent TypeScript reflection helpers for classes, properties, methods, and decorator metadata.",
  "keywords": [
    "typescript",
    "reflection",
    "reflect-metadata",
    "decorators",
    "metadata",
    "di",
    "introspection"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MurylloEx/typescript-reflector.git"
  },
  "bugs": {
    "url": "https://github.com/MurylloEx/typescript-reflector/issues"
  },
  "homepage": "https://github.com/MurylloEx/typescript-reflector#readme",
  "author": "Muryllo Pimenta de Oliveira",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "clean": "rimraf dist coverage",
    "build": "npm run clean && tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "prepare": "husky",
    "prepublishOnly": "npm run build",
    "start": "ts-node -r tsconfig-paths/register src/index.ts",
    "test": "jest",
    "test:cov": "jest --coverage",
    "test:watch": "jest --watch",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "lint": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.jest.json --noEmit"
  },
  "dependencies": {
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.29",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.3.4",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.3"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}
